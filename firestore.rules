rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for basic type and ID validation
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny rule as a catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Services collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isValidId(serviceId);
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if isValidId(eventId);
    }

    // Gallery collection
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    // Quick notices collection
    match /quick_notices/{noticeId} {
      allow read: if true;
      allow write: if isValidId(noticeId);
    }

    // Admin accounts collection
    match /admin_accounts/{id} {
      allow read, write: if true;
    }

    // Prayer requests collection
    match /prayer_requests/{requestId} {
      // Allow public creation of valid prayer requests
      allow create: if isValidId(requestId) 
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0 
        && request.resource.data.name.size() <= 150
        && request.resource.data.request is string 
        && request.resource.data.request.size() > 0 
        && request.resource.data.request.size() <= 2000;
        
      // Allow read and delete (for the admin dashboard managers)
      allow read, delete: if true;
      allow update: if false; // Prayer requests are immutable
    }

    // Registered Users collection
    match /registered_users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.auth.uid == userId || exists(/databases/$(database)/documents/admin_accounts/$(request.auth.uid)));
      allow delete: if request.auth != null && exists(/databases/$(database)/documents/admin_accounts/$(request.auth.uid));
    }

    // Gallery Comments collection
    match /gallery_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.galleryId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || exists(/databases/$(database)/documents/admin_accounts/$(request.auth.uid)));
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || exists(/databases/$(database)/documents/admin_accounts/$(request.auth.uid)));
    }

    // Gallery Reactions collection
    match /gallery_reactions/{reactionId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || exists(/databases/$(database)/documents/admin_accounts/$(request.auth.uid)));
    }
  }
}
