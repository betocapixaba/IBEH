{
  "entities": {
    "ChurchSettings": {
      "title": "Church Settings",
      "description": "Global settings for the church website",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name", "address", "phone"]
    },
    "Service": {
      "title": "Service",
      "description": "Scheduled church service",
      "type": "object",
      "properties": {
        "day": { "type": "string" },
        "time": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["day", "time"]
    },
    "Event": {
      "title": "Event",
      "description": "Church event or activity",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["title", "date", "imageUrl"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "Photo or video from a church event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["photo", "video"] }
      },
      "required": ["title", "date", "url", "type"]
    },
    "QuickNotice": {
      "title": "Quick Notice",
      "description": "Last-minute customizable announcement cards with specific sizes/colors",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "bgColor": { "type": "string" },
        "titleColor": { "type": "string" },
        "contentColor": { "type": "string" },
        "width": { "type": "integer" },
        "minHeight": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "content", "bgColor", "titleColor", "contentColor", "width", "minHeight", "createdAt"]
    },
    "PrayerRequest": {
      "title": "Prayer Request",
      "description": "Prayer request submitted by website visitors",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "request": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "request", "createdAt"]
    },
    "RegisteredUser": {
      "title": "Registered User",
      "description": "Registered visitor or church member details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "createdAt"]
    },
    "GalleryComment": {
      "title": "Gallery Comment",
      "description": "User comment on a photo gallery item",
      "type": "object",
      "properties": {
        "galleryId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["galleryId", "authorName", "authorEmail", "userId", "text", "createdAt"]
    },
    "GalleryReaction": {
      "title": "Gallery Reaction",
      "description": "User selection/reactions on a photo gallery memory entry",
      "type": "object",
      "properties": {
        "galleryId": { "type": "string" },
        "userId": { "type": "string" },
        "likes": { "type": "boolean" },
        "loves": { "type": "boolean" },
        "amens": { "type": "boolean" },
        "bless": { "type": "boolean" }
      },
      "required": ["galleryId", "userId", "likes", "loves", "amens", "bless"]
    }
  },
  "firestore": {
    "/settings/main": {
      "schema": "ChurchSettings",
      "description": "Primary church information"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Weekly services"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Church events"
    },
    "/gallery/{itemId}": {
      "schema": "GalleryItem",
      "description": "Media gallery items"
    },
    "/quick_notices/{noticeId}": {
      "schema": "QuickNotice",
      "description": "Customizable last-minute church announcement cards"
    },
    "/prayer_requests/{requestId}": {
      "schema": "PrayerRequest",
      "description": "Prayer requests submitted by visitors"
    },
    "/registered_users/{userId}": {
      "schema": "RegisteredUser",
      "description": "System registered members and users"
    },
    "/gallery_comments/{commentId}": {
      "schema": "GalleryComment",
      "description": "Persistent user comments on photo gallery memory entries"
    },
    "/gallery_reactions/{reactionId}": {
      "schema": "GalleryReaction",
      "description": "Persistent individual reaction settings per user per gallery item"
    }
  }
}
